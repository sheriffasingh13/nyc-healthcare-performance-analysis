# macOS system junk — invisible files the Mac Finder creates automatically
.DS_Store

# Data files are too large for GitHub (100 MB limit) and are re-downloadable
# from the public source documented in the README. Keep the folders, skip the files.
data/raw/*
!data/raw/.gitkeep
# Exceptions: the CMS files are small enough to include for reproducibility
!data/raw/Hospital_General_Information.csv
!data/raw/Timely_and_Effective_Care-Hospital.csv
data/cleaned/*
!data/cleaned/.gitkeep
!data/cleaned/nyc_hospitals_cleaned.csv

# Python temporary files
__pycache__/
*.pyc
.ipynb_checkpoints/

# Local environment files (never upload credentials or secrets)
.env

# Tableau temporary files
*.twbr
